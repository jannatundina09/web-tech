var RETRY_BACKOFF_MS = [500, 2000];
var KEEPALIVE_MAX_BODY_BYTES = 60000;

function noop() {}

function drainResponse(response) {
  try {
    if (response && typeof response.arrayBuffer === "function") {
      response.arrayBuffer().then(noop, noop);
    }
  } catch (err) {
    // ignore
  }
}

function post(send, attempt) {
  try {
    var body = JSON.stringify(send.payload);
    var init = {
      method: "POST",
      headers: { "Content-Type": send.contentType || "text/plain" },
      body: body,
      mode: "no-cors",
      credentials: "include"
    };

    if (body.length <= KEEPALIVE_MAX_BODY_BYTES) {
      init.keepalive = true;
    }

    fetch(send.endpoint, init).then(drainResponse, function () {
      retryOrReport(send, attempt);
    });
  } catch (err) {
    retryOrReport(send, attempt);
  }
}

function retryOrReport(send, attempt) {
  var retries = send.retries || 0;
  if (attempt < retries) {
    var delay = RETRY_BACKOFF_MS[attempt] || RETRY_BACKOFF_MS[RETRY_BACKOFF_MS.length - 1];
    setTimeout(function () {
      post(send, attempt + 1);
    }, delay);
    return;
  }

  self.postMessage({ type: "send_failed", endpoint: send.endpoint, attempts: attempt + 1 });
}

self.onmessage = function(e) {
  var sends = e.data && e.data.sends;
  if (!sends) return;
  for (var i = 0; i < sends.length; i++) {
    post(sends[i], 0);
  }
